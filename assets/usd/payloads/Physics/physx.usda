Generated from Composed Stage of root layer /home/exai/code/so101/assets/mjcf/SO101/payloads/base.usd
"""
    kilogramsPerUnit = 1
    metersPerUnit = 1
    subLayers = [
        @./physics.usda@
    ]
    upAxis = "Z"
)

over "so101_new_calib"
{
    over "Geometry"
    {
        over "base"
        {
            over "shoulder"
            {
                over "upper_arm"
                {
                    over "lower_arm"
                    {
                        over "wrist"
                        {
                            over "gripper"
                            {
                                over "moving_jaw_so101_v1"
                                {
                                    over "gripper" (
                                        prepend apiSchemas = ["PhysxJointAPI"]
                                    )
                                    {
                                        float physxJoint:armature = 0.028
                                        float physxJoint:jointFriction = 0.052
                                    }
                                }

                                over "wrist_roll" (
                                    prepend apiSchemas = ["PhysxJointAPI"]
                                )
                                {
                                    float physxJoint:armature = 0.028
                                    float physxJoint:jointFriction = 0.052
                                }
                            }

                            over "wrist_flex" (
                                prepend apiSchemas = ["PhysxJointAPI"]
                            )
                            {
                                float physxJoint:armature = 0.028
                                float physxJoint:jointFriction = 0.052
                            }
                        }

                        over "elbow_flex" (
                            prepend apiSchemas = ["PhysxJointAPI"]
                        )
                        {
                            float physxJoint:armature = 0.028
                            float physxJoint:jointFriction = 0.052
                        }
                    }

                    over "shoulder_lift" (
                        prepend apiSchemas = ["PhysxJointAPI"]
                    )
                    {
                        float physxJoint:armature = 0.028
                        float physxJoint:jointFriction = 0.052
                    }
                }

                over "shoulder_pan" (
                    prepend apiSchemas = ["PhysxJointAPI"]
                )
                {
                    float physxJoint:armature = 0.028
                    float physxJoint:jointFriction = 0.052
                }
            }
        }
    }
}

