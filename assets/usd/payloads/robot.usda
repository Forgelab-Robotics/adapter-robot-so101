#usda 1.0
(
    customLayerData = {
        string creator = "MuJoCo USD Converter v0.2.0"
    }
    defaultPrim = "so101_new_calib"
    doc = """Generated from Composed Stage of root layer /tmp/tmpdu7sekf4/so101_new_calib.usdc


Generated from Composed Stage of root layer /tmp/mjcf_import_SO101_ntz1nb3w/usdex_SO101/so101_new_calib.usdc


Generated from Composed Stage of root layer /tmp/mjcf_import_SO101_ntz1nb3w/temp_SO101/SO101.usd
"""
    kilogramsPerUnit = 1
    metersPerUnit = 1
    upAxis = "Z"
)

over "so101_new_calib" (
    prepend apiSchemas = ["IsaacRobotAPI"]
)
{
    prepend rel isaac:physics:robotJoints = [
        </so101_new_calib/Geometry/base/shoulder/shoulder_pan>,
        </so101_new_calib/Geometry/base/PhysicsFixedJoint>,
        </so101_new_calib/Geometry/base/shoulder/upper_arm/shoulder_lift>,
        </so101_new_calib/Geometry/base/shoulder/upper_arm/lower_arm/elbow_flex>,
        </so101_new_calib/Geometry/base/shoulder/upper_arm/lower_arm/wrist/wrist_flex>,
        </so101_new_calib/Geometry/base/shoulder/upper_arm/lower_arm/wrist/gripper/wrist_roll>,
        </so101_new_calib/Geometry/base/shoulder/upper_arm/lower_arm/wrist/gripper/moving_jaw_so101_v1/gripper>,
    ]
    prepend rel isaac:physics:robotLinks = [
        </so101_new_calib/Geometry/base>,
        </so101_new_calib/Geometry/base/shoulder>,
        </so101_new_calib/Geometry/base/shoulder/upper_arm>,
        </so101_new_calib/Geometry/base/shoulder/upper_arm/lower_arm>,
        </so101_new_calib/Geometry/base/shoulder/upper_arm/lower_arm/wrist>,
        </so101_new_calib/Geometry/base/shoulder/upper_arm/lower_arm/wrist/gripper>,
        </so101_new_calib/Geometry/base/shoulder/upper_arm/lower_arm/wrist/gripper/moving_jaw_so101_v1>,
    ]
    token isaac:robotType = "Default"

    over "Geometry"
    {
        over "base" (
            prepend apiSchemas = ["IsaacLinkAPI"]
        )
        {
            over "shoulder" (
                prepend apiSchemas = ["IsaacLinkAPI"]
            )
            {
                over "upper_arm" (
                    prepend apiSchemas = ["IsaacLinkAPI"]
                )
                {
                    over "lower_arm" (
                        prepend apiSchemas = ["IsaacLinkAPI"]
                    )
                    {
                        over "wrist" (
                            prepend apiSchemas = ["IsaacLinkAPI"]
                        )
                        {
                            over "gripper" (
                                prepend apiSchemas = ["IsaacLinkAPI"]
                            )
                            {
                                over "moving_jaw_so101_v1" (
                                    prepend apiSchemas = ["IsaacLinkAPI"]
                                )
                                {
                                    over "gripper" (
                                        prepend apiSchemas = ["IsaacJointAPI"]
                                    )
                                    {
                                    }
                                }

                                over "wrist_roll" (
                                    prepend apiSchemas = ["IsaacJointAPI"]
                                )
                                {
                                }
                            }

                            over "wrist_flex" (
                                prepend apiSchemas = ["IsaacJointAPI"]
                            )
                            {
                            }
                        }

                        over "elbow_flex" (
                            prepend apiSchemas = ["IsaacJointAPI"]
                        )
                        {
                        }
                    }

                    over "shoulder_lift" (
                        prepend apiSchemas = ["IsaacJointAPI"]
                    )
                    {
                    }
                }

                over "shoulder_pan" (
                    prepend apiSchemas = ["IsaacJointAPI"]
                )
                {
                }
            }

            over "PhysicsFixedJoint" (
                prepend apiSchemas = ["IsaacJointAPI"]
            )
            {
            }
        }
    }
}

